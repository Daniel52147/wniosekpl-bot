# Получить у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# Путь к базе пользователей (по умолчанию ./data/urzad.db)
DATABASE_PATH=./data/urzad.db
# Опционально: Postgres URL для production (см. scripts/postgres_schema.sql)
# DATABASE_URL=postgresql://user:pass@host:5432/wniosekpl

# Ваш Telegram ID для команды /stats (узнать у @userinfobot, НЕ ID бота)
ADMIN_TELEGRAM_IDS=2066158453

# Бесплатный режим — без оплаты (по умолчанию true)
FREE_MODE=true

# Бесплатные вопросы AI-помощнику в день
AI_FREE_DAILY_LIMIT=5

# Домены, которым разрешено обращаться к web API. Для локального MVP можно оставить *
WEB_CORS_ORIGINS=*

# Публичный URL сайта (нужен для Stripe/mock checkout)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── OmniRoute AI gateway (https://github.com/diegosouzapw/OmniRoute) ──
# bash scripts/start_omniroute.sh  → dashboard http://127.0.0.1:20128
OMNIROUTE_ENABLED=true
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Direct OpenAI / fallbacks (если OmniRoute недоступен)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Stripe (полная оплата; без ключей — mock checkout)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AI_MONTHLY=
STRIPE_PRICE_HUMAN_REVIEW=

# OAuth (Google / Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Секрет подписи OAuth state / cookies
APP_SECRET=change-me-to-a-long-random-string

# Admin API key for /api/admin/overview and /admin
ADMIN_API_KEY=

# Web session lifetime (days)
SESSION_DAYS=30

# Optional SMTP for magic-link emails
SMTP_HOST=
SMTP_FROM=

# Default country code
DEFAULT_COUNTRY=pl

# Только для локального Windows при SSL-ошибках (не использовать на Render)
# RELAX_SSL=true

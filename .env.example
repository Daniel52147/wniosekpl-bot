# Получить у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# Путь к базе пользователей (по умолчанию ./data/urzad.db)
DATABASE_PATH=./data/urzad.db

# Ваш Telegram ID для команды /stats (узнать у @userinfobot, НЕ ID бота)
ADMIN_TELEGRAM_IDS=2066158453

# Бесплатный режим — без оплаты (по умолчанию true)
FREE_MODE=true

# Только для локального Windows при SSL-ошибках (не использовать на Render)
# RELAX_SSL=true

# Получить у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# Путь к базе пользователей (по умолчанию ./data/urzad.db)
DATABASE_PATH=./data/urzad.db

# Ваш Telegram ID для команды /stats (узнать у @userinfobot, НЕ ID бота)
ADMIN_TELEGRAM_IDS=2066158453

# Бесплатный режим — без оплаты (по умолчанию true)
FREE_MODE=true

# Бесплатные вопросы AI-помощнику в день
AI_FREE_DAILY_LIMIT=5

# Домены, которым разрешено обращаться к web API. Для локального MVP можно оставить *
WEB_CORS_ORIGINS=*

# Публичный URL сайта (нужен для Stripe/mock checkout)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# OpenAI-compatible LLM (опционально; без ключа работает rule-based + knowledge)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Stripe (опционально; без ключа работает mock checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AI_MONTHLY=
STRIPE_PRICE_HUMAN_REVIEW=

# Admin API key for /api/admin/overview
ADMIN_API_KEY=

# Только для локального Windows при SSL-ошибках (не использовать на Render)
# RELAX_SSL=true
